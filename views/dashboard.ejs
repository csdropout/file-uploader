<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WaffleDrive</title>
  <script src="scripts/modals.js" defer></script>
  <link rel="stylesheet" href="css/styles.css">
</head>

<body>
  <%- include('partials/header.ejs') %>
  <button id="open-folder-dialog-btn">New Folder</button>
  <button id="open-file-dialog-btn">New File</button>
  <div class="dashboard-content">
    <div class="dashboard-headers">
      <span>Name</span>
      <span>Size</span>
      <span>Uploaded</span>
      <span></span>
    </div>
    <% if (locals.folders) { %>
    <% folders.forEach(folder => { %>
    <div class="folder-item">
      <span><%= folder.name %></span>
      <span><%= folder.size || "-" %></span>
      <span><%= folder.uploadedAt.toLocaleString() %></span>
      <span class="options-logo">&#8942</span>
    </div>
    <% }) %>
    <% } %>
    <% if (locals.files) { %>
    <% files.forEach(file => { %>
    <div class="file-item">
      <span><%= file.name %></span>
      <span><%= file.size %></span>
      <span><%= file.uploadedAt.toLocaleString() %></span>
      <span class="options-logo">&#8942</span>
    </div>
    <% }) %>
    <% } %>
    <%- include('partials/create-folder.ejs') %>
    <%- include('partials/upload-file.ejs') %>
  </div>
</body>

</html>