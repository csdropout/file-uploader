<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WaffleDrive</title>
  <script src="/scripts/modals.js" defer></script>
  <script src="/scripts/folderItems.js" defer></script>
  <script src="/scripts/fileItems.js" defer></script>
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
  <%- include('partials/header.ejs') %>
  <nav class="breadcrumb">
    <ol>
      <li><a href="/drive/folders">Home</a></li>
      <% breadcrumbs.forEach(folder => { %>
      <li><a href="/drive/folders/<%= folder.id %>"><%= folder.name %></a></li>
      <% }) %>
    </ol>
  </nav>
  <button id="open-folder-dialog-btn">New Folder</button>
  <button id="open-file-dialog-btn">New File</button>
  <div class="dashboard-content">
    <div class="dashboard-headers">
      <span>Name</span>
      <span>Size</span>
      <span>Uploaded</span>
      <span>Options</span>
    </div>
    <% if (locals.folders) { %>
    <% folders.forEach(folder => { %>
    <div class="folder-item" data-id="<%= folder.id %>">
      <span><%= folder.name %></span>
      <span><%= folder.size || "-" %></span>
      <span><%= folder.uploadedAt.toLocaleString() %></span>
      <div class="options">
        <button class="folder-rename-btn" data-name="<%= folder.name %>" data-id="<%= folder.id %>">Rename</button>
        <form action="/drive/folders/<%= folder.id %>/delete" method="post">
          <button type="submit">Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
    <% } %>
    <% if (locals.files) { %>
    <% files.forEach(file => { %>
    <div class="file-item" data-id="<%= file.id %>">
      <span><%= file.name %></span>
      <span><%= file.size %></span>
      <span><%= file.uploadedAt.toLocaleString() %></span>
      <div class="options">
        <a href="/drive/files/<%= file.id %>">Download</a>
        <button class="file-rename-btn" data-name="<%= file.name %>" data-id="<%= file.id %>">Rename</button>
        <form action="/drive/files/<%= file.id %>/delete" method="post">
          <button class="file-delete-btn">X</button>
        </form>
      </div>
    </div>
    <% }) %>
    <% } %>
    <%- include('partials/create-folder.ejs') %>
    <%- include('partials/rename-folder.ejs') %>
    <%- include('partials/rename-file.ejs') %>
    <%- include('partials/upload-file.ejs') %>
  </div>
</body>

</html>