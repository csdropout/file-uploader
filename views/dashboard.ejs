<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WaffleDrive</title>
  <script src="/scripts/modals.js" defer></script>
  <script src="/scripts/dashboard-items.js" defer></script>
  <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
  <%- include('partials/header.ejs') %>
  <nav class="breadcrumb">
    <ol>
      <li><a href="/drive">Home</a></li>
      <% breadcrumbs.forEach(folder => { %>
      <li><a href="/drive/folders/<%= folder.id %>"><%= folder.name %></a></li>
      <% }) %>
    </ol>
  </nav>
  <button id="open-folder-dialog-btn">New Folder</button>
  <button id="open-file-dialog-btn">New File</button>
  <div class="dashboard-content">
    <div class="dashboard-headers">
      <span>Name</span>
      <span>Size</span>
      <span>Uploaded</span>
      <span>Options</span>
    </div>
    <% if (locals.folders) { %>
    <% folders.forEach(folder => { %>
    <div class="dashboard-item folder-item" data-id="<%= folder.id %>">
      <span><%= folder.name %></span>
      <span><%= folder.size || "-" %></span>
      <span><%= folder.uploadedAt.toLocaleString() %></span>
      <div class="options">
        <div class="option-item">
          <button class="folder-rename-btn" data-name="<%= folder.name %>" data-id="<%= folder.id %>">
            <svg xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="#000">
              <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z" />
            </svg>
          </button>
        </div>
        <div class="option-item">
          <form action="/drive/folders/<%= folder.id %>/delete" method="post">
            <button type="submit">
              <svg xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="#000">
                <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
    <% } %>
    <% if (locals.files) { %>
    <% files.forEach(file => { %>
    <div class="dashboard-item file-item" data-id="<%= file.id %>">
      <span><%= file.name %></span>
      <span><%= formatFileSize(file.size) %></span>
      <span><%= file.uploadedAt.toLocaleString() %></span>
      <div class="options">
        <div class="option-item">
          <a href="/drive/files/<%= file.id %>">
            <svg xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="#000">
              <path d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z" />
            </svg>
          </a>
        </div>
        <div class="option-item">
          <button data-name="<%= file.name %>" data-id="<%= file.id %>">
            <svg xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="#000">
              <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z" />
            </svg>
          </button>
        </div>
        <div class="option-item">
          <form action="/drive/files/<%= file.id %>/delete" method="post">
            <button>
              <svg xmlns="http://www.w3.org/2000/svg" height="32px" viewBox="0 -960 960 960" width="32px" fill="#000">
                <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
    <% } %>
    <%- include('partials/create-folder.ejs') %>
    <%- include('partials/rename-folder.ejs') %>
    <%- include('partials/rename-file.ejs') %>
    <%- include('partials/upload-file.ejs') %>
  </div>
</body>

</html>