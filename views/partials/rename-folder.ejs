<dialog id="rename-folder-dialog">
  <form class="dialog-form" method="post" action="/drive/folders/update">
    <label for="name">Rename folder</label>
    <input type="text" name="name" id="name" required>
    <input type="hidden" name="id">
    <div class="dialog-form-button-group">
      <button id="close-rename-folder-dialog-btn" type="button">Cancel</button>
      <button type="submit">Update</button>
    </div>
  </form>
</dialog>