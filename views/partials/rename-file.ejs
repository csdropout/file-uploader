<dialog id="rename-file-dialog">
  <form method="post" action="/drive/files/update">
    <div class="form-row">
      <label for="name">Rename file</label>
      <input type="text" name="name" id="name" required>
    </div>
    <input type="hidden" name="id">
    <button id="close-rename-file-dialog-btn" type="button">Cancel</button>
    <button type="submit">Update</button>
  </form>
</dialog>