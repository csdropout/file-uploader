<dialog id="rename-file-dialog">
  <form class="dialog-form" method="post" action="/drive/files/update">
    <label for="name">Rename file</label>
    <input type="text" name="name" id="name" required>
    <input type="hidden" name="id">
    <div class="dialog-form-button-group">
      <button id="close-rename-file-dialog-btn" type="button">Cancel</button>
      <button type="submit">Update</button>
    </div>
  </form>
</dialog>