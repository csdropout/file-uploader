<dialog id="upload-file-dialog">
  <form class="dialog-form" method="post" action="/drive/files" enctype="multipart/form-data">
    <label for="file">Upload file</label>
    <input type="file" name="file" id="file" required>
    <span id="file-details"></span>
    <input type="text" name="folderId" value="<%= locals.folderId %>" hidden>
    <div class="dialog-form-button-group">
      <button type="button" id="close-file-dialog-btn">Cancel</button>
      <button type="submit">Upload</button>
    </div>
  </form>
</dialog>